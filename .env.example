# Copie para ".env" e ajuste. Todas as variáveis são opcionais (padrões = ambiente XAMPP/Laragon).
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=saep_db
DB_USER=root
DB_PASS=

# Deve ser a MESMA chave usada no saep_db.sql (AES_ENCRYPT dos CPFs)
CHAVE_CRIPTO=saep_barbearia_chave_2025

# Segredo para assinar o cookie de sessão. Em produção use um valor longo e aleatório.
SESSION_SECRET=troque-este-segredo

# Inatividade máxima da sessão, em segundos (padrão 1800 = 30 min)
SESSAO_TEMPO=1800

# Use true somente se o site for servido por HTTPS
COOKIE_SECURE=false
